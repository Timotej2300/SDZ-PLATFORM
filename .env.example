# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Iba server! Nikdy s prefixom NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Aplikacia
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=

# E-maily (Resend) - bez kluca sa pozvanky nezasielaju e-mailom, odkaz sa zobrazi pozivatelovi
RESEND_API_KEY=
EMAIL_FROM=SDZ <no-reply@sdz.sk>

# Cron (Vercel Cron posiela Authorization: Bearer $CRON_SECRET)
CRON_SECRET=

# Rate limit (lubovolny nahodny retazec)
RATE_LIMIT_SALT=
